# Secrets — never committed; copy .env.example to .env locally instead.
.env

# Python
__pycache__/
*.pyc

# The ~2.3 GB reference dataset (boundary shapefiles, guideline-rate CSVs,
# rainfall NetCDFs, census/groundwater data) — downloaded via the sidebar's
# "Download source data" button or a manual Drive link, not committed.
data/

# osmnx's Overpass HTTP response cache — ephemeral and regenerable, always
# lands here (see CACHE_DIR / ox.settings.cache_folder in config.py). The
# two small precomputed assets that used to live in a cache/ folder
# (mp_boundary.geojson, mp_location_index.parquet) now ship inside
# data_analysis_pipeline/ itself, so this whole directory can be ignored.
cache/

# A single shared, ever-growing log file (data_analysis_pipeline/orchestrator.py) —
# not run output worth versioning.
runs/pipeline.log

.DS_Store
