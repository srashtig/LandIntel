SERPAPI_KEY=
GEE_PROJECT_ID=

# Required for AI Insights / Q&A / report narrative generation (Groq).
GROQ_API_KEY=

# All of the above (and LAND_INTEL_DATA_DIR below) can also be set from the
# running app's sidebar instead of hand-editing this file — the sidebar
# writes back here, so either way ends up in the same place.

# Optional: override the Groq model used for chat/report generation.
# Defaults to openai/gpt-oss-20b if unset.
GROQ_MODEL=

# Optional: set to 1/true/yes to skip all SerpApi calls (e.g. once your
# SerpApi account is at/near its usage limit) — every call site already
# degrades gracefully to "unavailable" without a key, this flag just routes
# them there deliberately instead of by exhausting the quota.
DISABLE_SERPAPI=

# Optional: absolute path to the shared reference dataset (boundary
# shapefiles, guideline-rate CSVs, rainfall NetCDFs, etc.). Defaults to
# data/ (relative to this file) if unset.
LAND_INTEL_DATA_DIR=

# Optional: absolute path to where analysis runs (site_summary.json,
# map.html, report_assets/ per run) are saved to and loaded from. Defaults
# to runs/ (relative to this file) if unset.
LAND_INTEL_RUNS_DIR=

# Optional, set by whoever deploys this app (not an end-user setting): a
# Google Drive share link to a zip of the reference dataset above. When
# set, the sidebar's "Download source data" button fetches from this
# fixed URL — no end user ever pastes a link in themselves.
REFERENCE_DATA_BUNDLE_URL=
